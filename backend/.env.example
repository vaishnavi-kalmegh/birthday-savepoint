# Copy to .env and fill in. Never commit .env.
# All variables use the SAVEPOINT_ prefix.

# development | test | production. Production disables API docs.
SAVEPOINT_ENV=development

# SQLite for local development. For PostgreSQL install the "postgres" extra and use e.g.
# postgresql+psycopg://user:password@localhost:5432/savepoint
SAVEPOINT_DATABASE_URL=sqlite:///./savepoint.db

# Required. At least 32 random characters; used to derive CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SAVEPOINT_SECRET_KEY=change-me-generate-a-long-random-value

# Must be true when served over HTTPS (production). Set false only for local http development.
SAVEPOINT_COOKIE_SECURE=false

# Browser origins allowed to make state-changing requests (JSON list).
SAVEPOINT_ALLOWED_ORIGINS=["http://localhost:5173"]

# Base URL used when printing personal entry links.
SAVEPOINT_PUBLIC_BASE_URL=http://localhost:5173

# Set true only behind a trusted reverse proxy that appends the client IP to X-Forwarded-For.
SAVEPOINT_TRUST_FORWARDED_FOR=false
